# XIQ authentication: use a token, or leave it blank and provide username+password
export XIQ_API_TOKEN=""
# OR
export XIQ_USERNAME=""
export XIQ_PASSWORD=""

# (Optional) To use Platform ONE endpoint instead, uncomment:
# export XIQ_BASE_URL="https://cloudapi.extremecloudiq.com/xiq/v1"

# (Optional) SMTP failure notifications (--notify-email)
export SMTP_HOST="smtp.sendgrid.net"
export SMTP_PORT="587"
export SMTP_FROM="verified-sender@example.com"
export SMTP_USERNAME="apikey"
export SMTP_PASSWORD="replace-with-smtp-password"
